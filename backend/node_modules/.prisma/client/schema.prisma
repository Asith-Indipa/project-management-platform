generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(TEAM_MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
